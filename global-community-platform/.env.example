# Copy to .env (project root or backend/); settings.py loads it automatically.
# Real environment variables override values in .env.
# To test from a phone on your LAN, add your machine's IP (e.g. 192.168.1.20)
# to DJANGO_ALLOWED_HOSTS and its Vite origin (e.g. http://192.168.1.20:5173)
# to CORS_ALLOWED_ORIGINS and CSRF_TRUSTED_ORIGINS.

# Django
DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
REFRESH_COOKIE_NAME=cg_refresh
REFRESH_COOKIE_SECURE=False
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PATH=/api/v1/auth/

# Account emails (password reset, email confirmation). Links point at FRONTEND_URL.
# With DJANGO_DEBUG=True emails are saved as files in backend/sent_emails/ instead of sent.
FRONTEND_URL=http://localhost:5173
DEFAULT_FROM_EMAIL="CommonGround <no-reply@example.com>"
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# PASSWORD_RESET_TIMEOUT=3600

# Voice/video calls. STUN is enough on the same network; on the internet run a TURN
# server (see deploy/turnserver.conf.example) or many calls won't connect.
# WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# TURN_URLS=turn:turn.example.org:3478,turns:turn.example.org:5349
# TURN_SECRET=
THROTTLE_CALLS_RATE=30/hour

# Logging (stdout) and HSTS preload (only set True once you are sure: hard to undo).
LOG_LEVEL=INFO
# SECURE_HSTS_PRELOAD=False

# PostgreSQL connection pool per app worker (used when DATABASE_URL is PostgreSQL).
# Keep workers × DB_POOL_MAX_SIZE below PostgreSQL's max_connections.
# DB_POOL_MAX_SIZE=10

# Optional PostgreSQL connection. Leave blank to use SQLite for local quick start.
DATABASE_URL=
REDIS_URL=
WEBSOCKET_TICKET_TTL_SECONDS=15

# API rate limits (DRF format: N/second|minute|hour|day).
THROTTLE_ANON_RATE=1000/hour
THROTTLE_USER_RATE=5000/hour
# Login + registration attempts per client IP.
THROTTLE_AUTH_RATE=10/minute
# Contact-matching requests per user (limits probing which numbers are members).
THROTTLE_CONTACTS_RATE=20/hour
# Requests that send email (password reset, confirmation resend, email change).
THROTTLE_ACCOUNT_EMAIL_RATE=5/hour
# Country code applied to local phone numbers (e.g. 0712...) when matching contacts.
DEFAULT_PHONE_COUNTRY_CODE=255
# Number of reverse proxies in front of Django (Vite dev server, nginx, load
# balancer). Used to find the real client IP in X-Forwarded-For.
# 0 = use the direct connection address only. Use 1 with the Vite dev proxy.
# Never set it higher than the real number of proxies, or clients can fake IPs.
NUM_PROXIES=1

# React frontend
VITE_API_URL=/api/v1

# Production requires DJANGO_ENV=production plus non-empty values for:
# DJANGO_SECRET_KEY, DJANGO_ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS,
# CSRF_TRUSTED_ORIGINS, DATABASE_URL, REDIS_URL, FRONTEND_URL (https://) and,
# with the SMTP backend, EMAIL_HOST.
# In production set REFRESH_COOKIE_SECURE=True. Use
# REFRESH_COOKIE_SAMESITE=None only for cross-site frontend/API deployments;
# HTTPS is required for Secure cookies. Set CORS_ALLOWED_ORIGINS and
# CSRF_TRUSTED_ORIGINS to exact production origins (scheme, host, and port).
# Configure REDIS_URL for deployments with multiple backend workers; it is
# used for both Channels and the shared WebSocket-ticket cache.

# Push notifications to closed apps: `python manage.py generate_vapid_keys` prints these.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@example.org
# Encrypts two-step sign-in secrets (defaults to DJANGO_SECRET_KEY).
# TWO_FACTOR_ENCRYPTION_KEY=

# Money: tips and sponsored posts, paid with mobile money or cards through Flutterwave
# (docs/DEPLOY.md, "Payments"). Without a key, development uses a test gateway that
# pays instantly and production switches payments off.
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_SECRET_HASH=
# TIP_PLATFORM_FEE_PERCENT=10
# PROMOTION_DAILY_PRICE=3000
# REFERRAL_REWARD_AMOUNT=1000
